<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Wi24rdFTP</AssemblyName>
    <RootNamespace>Wi24rdFTP</RootNamespace>
    <Version>1.0.0</Version>
    <Company>Wi24rd</Company>
    <Product>Wi24rd FTP</Product>
    <AssemblyTitle>Wi24rd FTP</AssemblyTitle>
    <ApplicationIcon>Assets\wi24rd-ftp.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\wi24rd-ftp.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Scripts\Wi24rdFtp.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
