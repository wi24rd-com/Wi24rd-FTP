<Window x:Class="Wi24rdFTP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wi24rd FTP"
        Icon="Assets/wi24rd-ftp.ico"
        Width="980" Height="720" MinWidth="860" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Brush.Text}"
        AllowDrop="True"
        DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter"
        DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="{StaticResource Brush.Navy}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/logo-64.png" Width="44" Height="44"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="21" FontWeight="Bold" Foreground="White">
                            <Run Text="Wi"/><Run Text="24" Foreground="{StaticResource Brush.Cyan}"/><Run Text="rd FTP"/>
                        </TextBlock>
                        <TextBlock Text="Sikker, midlertidig fildeling" FontSize="12"
                                   Foreground="{StaticResource Brush.Muted}" Margin="0,-2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border x:Name="StatusPill" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="{StaticResource Brush.NavyLight}" BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1" CornerRadius="16" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#8FA6C4" VerticalAlignment="Center"/>
                        <TextBlock x:Name="StatusText" Text="Stoppet" Foreground="White" FontWeight="SemiBold"
                                   FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- BANNER: forudsætninger mangler -->
        <Border x:Name="PrereqBanner" Grid.Row="1" Background="{StaticResource Brush.AmberPale}"
                BorderBrush="{StaticResource Brush.Amber}" BorderThickness="0,0,0,1" Padding="22,10"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnInstall" DockPanel.Dock="Right" Content="Installér nu"
                        Style="{StaticResource PrimaryButton}" Padding="16,6" MinHeight="32"
                        Click="BtnInstall_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource Brush.Amber}" VerticalAlignment="Center"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="Windows' indbyggede FTP-server er ikke installeret endnu. Klik Installér nu – det kræver administrator-godkendelse og tager et par minutter."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BANNER: kører eleveret (drag-and-drop virker ikke) -->
        <Border x:Name="ElevatedBanner" Grid.Row="2" Background="{StaticResource Brush.AmberPale}"
                BorderBrush="{StaticResource Brush.Amber}" BorderThickness="0,0,0,1" Padding="22,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource Brush.Amber}" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="Programmet kører som administrator. Windows blokerer så træk-og-slip fra Stifinder – start Wi24rd FTP fra Start-menuen eller skrivebordet i stedet. Gennemse-knapperne virker stadig."/>
            </StackPanel>
        </Border>

        <!-- INDHOLD -->
        <Grid Grid.Row="3" Margin="22,18,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="2*" MaxWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Venstre: filer -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="18,16,18,0">
                        <Button DockPanel.Dock="Right" Content="Åbn mappe" Style="{StaticResource LinkButton}"
                                Click="BtnOpenFolder_Click"/>
                        <TextBlock Text="FILER DER DELES" Style="{StaticResource CardTitle}" Margin="0"/>
                    </DockPanel>

                    <!-- Drop-zone -->
                    <Grid Grid.Row="1" Margin="18,12,18,0" Height="140" x:Name="DropZone" Background="Transparent">
                        <Rectangle x:Name="DropOutline" Stroke="{StaticResource Brush.Border}" StrokeThickness="2"
                                   StrokeDashArray="6 4" RadiusX="4" RadiusY="4" Fill="{StaticResource Brush.Field}"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="{StaticResource Brush.Cyan}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Træk filer eller mapper hertil" FontSize="15" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="De kopieres til Wi24rd FTP – originalerne røres ikke" FontSize="12"
                                       Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                <Button Content="Gennemse filer…" Style="{StaticResource SecondaryButton}"
                                        Padding="14,6" MinHeight="32" Click="BtnBrowseFiles_Click"/>
                                <Button Content="Vælg mappe…" Style="{StaticResource SecondaryButton}"
                                        Padding="14,6" MinHeight="32" Margin="8,0,0,0" Click="BtnBrowseFolder_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Filliste -->
                    <Grid Grid.Row="2" Margin="12,10,12,10">
                        <ListView x:Name="FileList" Style="{StaticResource FileList}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Width="34">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{StaticResource Brush.Muted}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Navn" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                    <GridViewColumn Header="Størrelse" Width="110" DisplayMemberBinding="{Binding SizeText}"/>
                                    <GridViewColumn Header="Tilføjet" Width="130" DisplayMemberBinding="{Binding AddedText}"/>
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#xE74D;" Style="{StaticResource IconButton}"
                                                        ToolTip="Fjern fra Wi24rd FTP" Tag="{Binding}"
                                                        Click="BtnRemoveFile_Click"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <TextBlock x:Name="EmptyHint" Text="Ingen filer endnu – træk dem ind ovenfor."
                                   Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Højre: forbindelse + status -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="FORBINDELSE" Style="{StaticResource CardTitle}" Margin="0,0,0,6"/>

                        <TextBlock Text="Protokol" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeFtp" Content="FTP · port 21" Style="{StaticResource SegmentRadio}"
                                         IsChecked="True" GroupName="Mode" Checked="Mode_Checked"/>
                            <RadioButton x:Name="ModeSftp" Content="SFTP · port 22" Style="{StaticResource SegmentRadio}"
                                         GroupName="Mode" Checked="Mode_Checked"/>
                        </StackPanel>

                        <TextBlock Text="Adresse (vælg den der kan nås udefra)" Style="{StaticResource Label}"/>
                        <ItemsControl x:Name="IpList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="14"
                                               Foreground="{StaticResource Brush.Text}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="IpHint" Text="Vises når serveren er startet" Style="{StaticResource Value}"
                                   Foreground="{StaticResource Brush.Muted}"/>

                        <TextBlock Text="Brugernavn" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                    ToolTip="Kopiér" Click="BtnCopyUser_Click"/>
                            <TextBox x:Name="UserBox" Style="{StaticResource MonoValue}" Text="wi24rdftp"/>
                        </DockPanel>

                        <TextBlock Text="Adgangskode" Style="{StaticResource Label}"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnNewPassword" Content="&#xE72C;" Style="{StaticResource IconButton}"
                                        ToolTip="Ny adgangskode" Click="BtnNewPassword_Click"/>
                                <Button Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                        ToolTip="Kopiér" Click="BtnCopyPassword_Click"/>
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                    Background="{StaticResource Brush.Field}" CornerRadius="3" Padding="10,6">
                                <TextBlock x:Name="PasswordText" FontFamily="Cascadia Mono, Consolas" FontSize="17"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Border Background="{StaticResource Brush.PwDigit}" CornerRadius="2" Padding="6,1" Margin="0,0,6,0">
                                <TextBlock Text="tal" Foreground="#07132A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource Brush.PwUpper}" CornerRadius="2" Padding="6,1" Margin="0,0,6,0">
                                <TextBlock Text="STORT bogstav" Foreground="#07132A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource Brush.PwLower}" CornerRadius="2" Padding="6,1">
                                <TextBlock Text="lille bogstav" Foreground="#07132A" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.Muted}"
                                   Text="Modtageren får kun læseadgang. Kontoen lukkes igen ved Stop."/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource CardTitle}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server" Style="{StaticResource Label}" Margin="0,2,16,2"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="SvcStatus" Text="–" Style="{StaticResource Value}" Margin="0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Firewall" Style="{StaticResource Label}" Margin="0,2,16,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="FwStatus" Text="–" Style="{StaticResource Value}" Margin="0,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Filer" Style="{StaticResource Label}" Margin="0,2,16,2"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="FileStatus" Text="0" Style="{StaticResource Value}" Margin="0,2"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- BUNDLINJE -->
        <Border Grid.Row="4" Background="{StaticResource Brush.Navy}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="Busy" Width="110" Height="4" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{StaticResource Brush.Cyan}"
                                 Background="{StaticResource Brush.NavyLight}"
                                 BorderThickness="0" Margin="0,0,12,0"/>
                    <TextBlock x:Name="LogLine" Text="Klar." Foreground="{StaticResource Brush.Muted}" FontSize="13"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Content="▶  Start FTP" Style="{StaticResource PrimaryButton}"
                            MinWidth="140" Click="BtnStart_Click"/>
                    <Button x:Name="BtnStop" Content="■  Stop FTP" Style="{StaticResource DangerButton}"
                            MinWidth="140" Margin="10,0,0,0" IsEnabled="False" Click="BtnStop_Click"/>
                    <Button x:Name="BtnClose" Content="Luk program" Style="{StaticResource SecondaryButton}"
                            MinWidth="130" Margin="10,0,0,0" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
