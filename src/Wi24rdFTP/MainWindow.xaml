<Window x:Class="Wi24rdFTP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wi24rdFTP"
        Title="{x:Static loc:L.AppTitle}"
        Icon="Assets/wi24rd-ftp.ico"
        Width="1020" Height="800" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource Brush.Text}"
        AllowDrop="True"
        DragEnter="DropZone_DragEnter" DragOver="DropZone_DragEnter"
        DragLeave="DropZone_DragLeave" Drop="DropZone_Drop"
        Closing="Window_Closing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="84"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="86"/>
        </Grid.RowDefinitions>

        <!-- HEADER (blå gradient) -->
        <Border Grid.Row="0" Background="{StaticResource Brush.HeaderGradient}">
            <Grid>
                <!-- dekorativ bølge -->
                <Path Data="M0,70 C200,20 420,110 640,60 C820,20 1000,80 1200,40 L1200,0 L0,0 Z"
                      Fill="#FFFFFF" Opacity="0.10" Stretch="Fill" VerticalAlignment="Top" Height="84"/>
                <Path Data="M0,84 C260,40 520,100 780,50 C960,16 1100,60 1200,30 L1200,84 Z"
                      Fill="#0A3FB8" Opacity="0.22" Stretch="Fill" VerticalAlignment="Top" Height="84"/>
                <Path Data="M300,84 C500,30 700,90 900,45 C1050,15 1150,50 1200,40 L1200,0 L300,0 Z"
                      Fill="#FFFFFF" Opacity="0.06" Stretch="Fill" VerticalAlignment="Top" Height="84"/>
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/logo-64.png" Width="52" Height="52"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="24" FontWeight="Bold" Foreground="White">
                                <Run Text="Wi"/><Run Text="24" Foreground="#BFE3FF"/><Run Text="rd FTP"/>
                            </TextBlock>
                            <TextBlock Text="{x:Static loc:L.Tagline}" FontSize="13"
                                       Foreground="#DCEBFF" Margin="0,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border x:Name="StatusPill" VerticalAlignment="Center"
                                Background="#FFFFFF" Opacity="0.95" CornerRadius="20" Padding="18,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#9AA8BB" VerticalAlignment="Center"/>
                                <TextBlock x:Name="StatusText" Text="{x:Static loc:L.Stopped}" Foreground="{StaticResource Brush.Accent}"
                                           FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource HeaderIconButton}" Content="&#xE946;" ToolTip="{x:Static loc:L.About}"
                                Margin="12,0,0,0" Click="BtnAbout_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- BANNER: forudsætninger mangler -->
        <Border x:Name="PrereqBanner" Grid.Row="1" Background="{StaticResource Brush.AmberPale}"
                BorderBrush="{StaticResource Brush.Amber}" BorderThickness="0,0,0,1" Padding="22,10"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnInstall" DockPanel.Dock="Right" Content="{x:Static loc:L.InstallNow}"
                        Style="{StaticResource PrimaryButton}" Padding="16,6" MinHeight="32"
                        Click="BtnInstall_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource Brush.Amber}" VerticalAlignment="Center"/>
                    <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                               Text="{x:Static loc:L.PrereqBanner}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- BANNER: kører eleveret -->
        <Border x:Name="ElevatedBanner" Grid.Row="2" Background="{StaticResource Brush.AmberPale}"
                BorderBrush="{StaticResource Brush.Amber}" BorderThickness="0,0,0,1" Padding="22,8"
                Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{StaticResource Brush.Amber}" VerticalAlignment="Center"/>
                <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="{x:Static loc:L.ElevatedBanner}"/>
            </StackPanel>
        </Border>

        <!-- BANNER: opdatering tilgængelig -->
        <Border x:Name="UpdateBanner" Grid.Row="3" Background="{StaticResource Brush.AccentPale}"
                BorderBrush="{StaticResource Brush.Accent}" BorderThickness="0,0,0,1" Padding="22,8"
                Visibility="Collapsed">
            <DockPanel>
                <Button x:Name="BtnDownloadUpdate" DockPanel.Dock="Right" Content="{x:Static loc:L.Download}"
                        Style="{StaticResource PrimaryButton}" Padding="16,6" MinHeight="32" Click="BtnDownloadUpdate_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="UpdateText" Margin="10,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- STATUS-strimmel -->
        <Border Grid.Row="4" Margin="22,16,22,14" Style="{StaticResource Card}" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,28,0">
                    <TextBlock Text="&#xE946;" Style="{StaticResource LabelIcon}" FontSize="18"/>
                    <TextBlock Text="{x:Static loc:L.Status}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="&#xE968;" Style="{StaticResource LabelIcon}" Foreground="{StaticResource Brush.Muted}"/>
                    <TextBlock Text="{x:Static loc:L.Server}" Style="{StaticResource Value}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse x:Name="SvcDot" Width="9" Height="9" Fill="{StaticResource Brush.Grey}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SvcStatus" Text="–" Style="{StaticResource Value}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="&#xE83D;" Style="{StaticResource LabelIcon}" Foreground="{StaticResource Brush.Muted}"/>
                    <TextBlock Text="{x:Static loc:L.Firewall}" Style="{StaticResource Value}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse x:Name="FwDot" Width="9" Height="9" Fill="{StaticResource Brush.Grey}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FwStatus" Text="–" Style="{StaticResource Value}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <TextBlock Text="&#xE8A5;" Style="{StaticResource LabelIcon}" Foreground="{StaticResource Brush.Muted}"/>
                    <TextBlock Text="{x:Static loc:L.Files}" Style="{StaticResource Value}" Foreground="{StaticResource Brush.Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="FileStatus" Text="0" Style="{StaticResource Value}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- INDHOLD -->
        <Grid Grid.Row="5" Margin="22,0,22,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="2*" MaxWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Venstre: filer -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="20,18,20,0">
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Click="BtnOpenFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:L.OpenFolder}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xED25;" Style="{StaticResource LabelIcon}" FontSize="18"/>
                            <TextBlock Text="{x:Static loc:L.FilesShared}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Drop-zone -->
                    <Grid Grid.Row="1" Margin="20,14,20,0" Height="170" x:Name="DropZone" Background="Transparent">
                        <Border x:Name="DropOutline" BorderBrush="{StaticResource Brush.Border}" BorderThickness="2"
                                CornerRadius="10" Background="{StaticResource Brush.Field}"/>
                        <Rectangle Stroke="{StaticResource Brush.Border}" StrokeThickness="0" StrokeDashArray="6 4"
                                   RadiusX="10" RadiusY="10" Margin="0" x:Name="DropDash"/>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                       Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Static loc:L.DropTitle}" FontSize="17" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,6,0,2"/>
                            <TextBlock Text="{x:Static loc:L.DropSub}" FontSize="13"
                                       Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Padding="18,8" Click="BtnBrowseFiles_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Static loc:L.BrowseFiles}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SecondaryButton}" Padding="18,8" Margin="10,0,0,0" Click="BtnBrowseFolder_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.Accent}"/>
                                        <TextBlock Text="{x:Static loc:L.ChooseFolder}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Filliste -->
                    <Border Grid.Row="2" Margin="20,14,20,20" BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Background="{StaticResource Brush.Card}">
                        <Grid>
                            <ListView x:Name="FileList" Style="{StaticResource FileList}" Margin="4" SizeChanged="FileList_SizeChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="36">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14" Foreground="{StaticResource Brush.Accent}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn x:Name="ColName" Header="{x:Static loc:L.ColName}" Width="300" DisplayMemberBinding="{Binding Name}"/>
                                        <GridViewColumn x:Name="ColSize" Header="{x:Static loc:L.ColSize}" Width="130" DisplayMemberBinding="{Binding SizeText}"/>
                                        <GridViewColumn x:Name="ColAdded" Header="{x:Static loc:L.ColAdded}" Width="140" DisplayMemberBinding="{Binding AddedText}"/>
                                        <GridViewColumn Width="52">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="&#xE74D;" Style="{StaticResource RowIconButton}" HorizontalAlignment="Center"
                                                            ToolTip="{x:Static loc:L.RemoveTip}" Tag="{Binding}"
                                                            Click="BtnRemoveFile_Click"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xF12B;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                                           Foreground="{StaticResource Brush.Border}" HorizontalAlignment="Center"/>
                                <TextBlock Text="{x:Static loc:L.EmptyList}" Margin="0,10,0,0"
                                           Foreground="{StaticResource Brush.Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Højre: forbindelse + status -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>

                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="&#xE968;" Style="{StaticResource LabelIcon}" FontSize="18"/>
                            <TextBlock Text="{x:Static loc:L.Connection}" Style="{StaticResource CardTitle}" Margin="0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource LabelIcon}"/>
                            <TextBlock Text="{x:Static loc:L.Protocol}" Style="{StaticResource Label}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModeFtp" Style="{StaticResource SegmentRadio}" IsChecked="True"
                                         GroupName="Mode" Checked="Mode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="FTP · port 21" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ModeSftp" Style="{StaticResource SegmentRadio}"
                                         GroupName="Mode" Checked="Mode_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="SFTP · port 22" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                            <TextBlock Text="&#xE774;" Style="{StaticResource LabelIcon}"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0">
                                <Run Text="{x:Static loc:L.Address}"/><Run Text="{x:Static loc:L.AddressHint}" FontWeight="Normal" Foreground="{StaticResource Brush.Muted}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="10,6">
                            <StackPanel>
                                <ItemsControl x:Name="IpList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                                       Foreground="{StaticResource Brush.Text}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="IpHint" Text="{x:Static loc:L.IpHint}" FontSize="13"
                                           Foreground="{StaticResource Brush.Muted}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                            <TextBlock Text="&#xE77B;" Style="{StaticResource LabelIcon}"/>
                            <TextBlock Text="{x:Static loc:L.Username}" Style="{StaticResource Label}" Margin="0"/>
                        </StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                    ToolTip="{x:Static loc:L.Copy}" Click="BtnCopyUser_Click"/>
                            <TextBox x:Name="UserBox" Style="{StaticResource MonoValue}" Text="wi24rdftp"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,5">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource LabelIcon}"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0">
                                <Run Text="{x:Static loc:L.Password}"/><Run Text="{x:Static loc:L.PasswordHint}" FontWeight="Normal" Foreground="{StaticResource Brush.Muted}"/>
                            </TextBlock>
                        </StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnNewPassword" Content="&#xE72C;" Style="{StaticResource IconButton}"
                                        ToolTip="{x:Static loc:L.NewPassword}" Click="BtnNewPassword_Click"/>
                                <Button Content="&#xE8C8;" Style="{StaticResource IconButton}"
                                        ToolTip="{x:Static loc:L.Copy}" Click="BtnCopyPassword_Click"/>
                            </StackPanel>
                            <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" Height="36"
                                    Background="{StaticResource Brush.Field}" CornerRadius="6" Padding="10,0">
                                <TextBlock x:Name="PasswordText" FontFamily="Cascadia Mono, Consolas" FontSize="15"
                                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Border>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Border Background="{StaticResource Brush.PwDigitPale}" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock Text="{x:Static loc:L.LegendDigit}" Foreground="{StaticResource Brush.PwDigit}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource Brush.PwUpperPale}" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                <TextBlock Text="{x:Static loc:L.LegendUpper}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="{StaticResource Brush.PwLowerPale}" CornerRadius="4" Padding="8,2">
                                <TextBlock Text="{x:Static loc:L.LegendLower}" Foreground="{StaticResource Brush.PwLower}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>

                        <Border Background="{StaticResource Brush.AccentPale}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                           Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Brush.Text}"
                                           Text="{x:Static loc:L.ReadOnlyInfo}"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </Grid>
            </ScrollViewer>
        </Grid>

        <!-- BUNDLINJE -->
        <Border Grid.Row="6" Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="17" Background="{StaticResource Brush.AccentPale}" Margin="0,0,12,0">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="{StaticResource Brush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ProgressBar DockPanel.Dock="Left" x:Name="Busy" Width="110" Height="4" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{StaticResource Brush.Accent}"
                                 Background="{StaticResource Brush.AccentPale}" BorderThickness="0" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="LogLine" Text="{x:Static loc:L.Ready}" FontWeight="SemiBold" FontSize="13"
                                   TextWrapping="Wrap" LineHeight="17" LineStackingStrategy="BlockLineHeight"/>
                        <TextBlock x:Name="LogHint" Text="{x:Static loc:L.HintStart}" FontSize="11.5"
                                   Foreground="{StaticResource Brush.Muted}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStart" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="BtnStart_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BtnStartText" Text="{x:Static loc:L.StartFtp}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStop" Style="{StaticResource DangerButton}" MinWidth="150" Margin="10,0,0,0"
                            IsEnabled="False" Click="BtnStop_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BtnStopText" Text="{x:Static loc:L.StopFtp}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClose" Style="{StaticResource SecondaryButton}" MinWidth="150" Margin="10,0,0,0" Click="BtnClose_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Static loc:L.CloseApp}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
