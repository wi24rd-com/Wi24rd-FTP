<Window x:Class="Wi24rdFTP.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Wi24rdFTP"
        Title="{x:Static loc:L.About}"
        Icon="Assets/wi24rd-ftp.ico"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Brush.Card}" FontFamily="Segoe UI"
        Foreground="{StaticResource Brush.Text}">
    <StackPanel Margin="28,26,28,22">
        <StackPanel Orientation="Horizontal">
            <Image Source="Assets/logo-128.png" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="22" FontWeight="Bold">
                    <Run Text="Wi"/><Run Text="24" Foreground="{StaticResource Brush.Accent}"/><Run Text="rd FTP"/>
                </TextBlock>
                <TextBlock x:Name="VersionText" FontSize="13" Foreground="{StaticResource Brush.Muted}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{x:Static loc:L.Tagline}" Margin="0,18,0,0" FontSize="14"/>
        <TextBlock Text="{x:Static loc:L.AboutDescription}" Margin="0,6,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Muted}"/>

        <Border Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="© 2026 Wi24rd" FontSize="13"/>
                <TextBlock FontSize="13" Margin="0,4,0,0">
                    <Run Text="{x:Static loc:L.License}"/><Run Text=": MIT"/>
                </TextBlock>
                <TextBlock FontSize="13" Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://github.com/wi24rd-com/Wi24rd-FTP" RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource Brush.Accent}">github.com/wi24rd-com/Wi24rd-FTP</Hyperlink>
                </TextBlock>
                <TextBlock FontSize="13" Margin="0,4,0,0">
                    <Hyperlink NavigateUri="https://github.com/wi24rd-com/Wi24rd-FTP/blob/main/LICENSE" RequestNavigate="Link_RequestNavigate"
                               Foreground="{StaticResource Brush.Accent}"><Run Text="{x:Static loc:L.ReadLicense}"/></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Text="{x:Static loc:L.AboutCredits}" Margin="0,14,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{StaticResource Brush.Muted}"/>

        <Button Content="{x:Static loc:L.Close}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                MinWidth="110" Margin="0,18,0,0" IsDefault="True" IsCancel="True"/>
    </StackPanel>
</Window>
